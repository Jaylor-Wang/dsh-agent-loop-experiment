{
  "name": "dsh-agent-loop-experiment",
  "description": "Isolated convergence-policy experiments around the unchanged official DSH agent loop.",
  "version": "0.2.2-rc.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaylor-Wang/dsh-agent-loop-experiment.git"
  },
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./baseline": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./policy": {
      "types": "./src/convergence.d.ts",
      "default": "./src/convergence.js"
    },
    "./replacement": {
      "types": "./src/replacement.d.ts",
      "default": "./src/replacement.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "EXPERIMENT.md",
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "dsh": "0.2.2-rc.1"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "test": "node --test --test-timeout=15000 test/*.test.js",
    "experiment": "node scripts/compare.mjs",
    "experiment:live": "node scripts/live.mjs",
    "inspect:profile": "node scripts/inspect-profile.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm-deepseek-api-key": "0.2.2-rc.1",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-testkit": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  }
}
